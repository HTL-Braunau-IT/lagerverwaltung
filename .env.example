# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/lagerverwaltung"

# Auth (Microsoft 365 / Entra ID)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AZURE_AD_TENANT_ID=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""

# Entra Group -> App Role mapping
# Users can be in multiple groups; effective role priority is:
# admin > teacher > student
ROLE_ADMIN_GROUP_ID=""
ROLE_TEACHER_GROUP_ID=""
ROLE_STUDENT_GROUP_ID=""

# Office 365 email sender
# Shared mailbox address used for Graph sendMail: /users/{MAIL_FROM_ADDRESS}/sendMail
MAIL_FROM_ADDRESS=""
# Optional audit/ops copy for all transactional emails
MAIL_OPS_BCC_ADDRESS=""

# Azure callback URL to configure in App Registration:
# http://localhost:3000/api/auth/callback/azure-ad

# Azure API permissions to configure:
# - OpenID permissions: openid, profile, email, offline_access
# - Microsoft Graph delegated: User.Read
# - Optional (only if using Graph fallback for group overage): GroupMember.Read.All (admin consent required)

# Legacy VirtueMart import
LEGACY_DB_HOST=""
LEGACY_DB_PORT="3306"
LEGACY_DB_USER=""
LEGACY_DB_PASSWORD=""
LEGACY_DB_NAME=""
# Base URL of legacy site used to resolve relative media paths from file_url/file_url_thumb.
# Example: https://legacy.example.com
LEGACY_MEDIA_BASE_URL=""