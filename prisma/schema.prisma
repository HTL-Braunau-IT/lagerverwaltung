// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum UnitKind {
    PIECE
    LENGTH
    AREA
    WEIGHT
    VOLUME
}

enum BaseUnit {
    PCS
    MM
    CM
    M
    CM2
    DM2
    MM2
    M2
    G
    KG
    ML
    L
}

enum AppRole {
    ADMIN
    TEACHER
    STUDENT
}

enum OrderStatus {
    OPEN
    PREPARING
    READY_FOR_PICKUP
}

enum OrderApprovalStatus {
    NOT_REQUIRED
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum RequestStatus {
    PENDING
    APPROVED
    REJECTED
}

enum LoanStatus {
    PENDING
    APPROVED
    REJECTED
    CLOSED
}

enum LoanReminderTrigger {
    DUE
    OVERDUE
    MANUAL
}

model Category {
    id        String    @id @default(cuid())
    name      String
    slug      String?   @unique
    products  Product[] @relation("PrimaryProductCategory")
    productLinks ProductCategory[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@unique([name])
}

model StorageLocation {
    id            String      @id @default(cuid())
    code          String      @unique
    name          String
    storageRoomId String
    storageRoom   StorageRoom @relation(fields: [storageRoomId], references: [id], onDelete: Restrict)
    description   String?
    products      Product[]
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    @@index([storageRoomId])
}

model StorageRoom {
    id               String            @id @default(cuid())
    name             String            @unique
    storageLocations StorageLocation[]
    userAccesses     UserStorageRoomAccess[]
    orders           Order[]
    loans            Loan[]
    lendableItems    LendableItem[]
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
}

model Product {
    id                String          @id @default(cuid())
    name              String
    sku               String          @unique
    isVisible         Boolean         @default(true)
    description       String?
    price             Decimal         @db.Decimal(12, 2)
    quantityOnHand    Decimal         @default(0) @db.Decimal(14, 3)
    minimumQuantity   Decimal         @default(0) @db.Decimal(14, 3)
    unitKind          UnitKind
    baseUnit          BaseUnit
    unitStep          Decimal         @default(1) @db.Decimal(14, 3)
    categoryId        String
    storageLocationId String?
    /** Optional drawer section / compartment ("Fach") within the storage location, for faster picking. */
    compartment       String?
    /** Flagged by an admin for restocking; surfaced as the backend "Nachbestellen" list. */
    needsReorder      Boolean         @default(false)
    category          Category        @relation("PrimaryProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
    categories        ProductCategory[]
    storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
    images            ProductImage[]
    documents         ProductDocument[]
    cartItems         CartItem[]
    savedCartItems    SavedCartItem[]
    orderItems        OrderItem[]
    orderRequestItems OrderRequestItem[]
    partListItems     PartListItem[]
    stockBookings     ProductStockBooking[]
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt

    @@index([name])
    @@index([categoryId])
    @@index([storageLocationId])
    @@index([quantityOnHand, minimumQuantity])
}

model ProductCategory {
    id         String   @id @default(cuid())
    productId  String
    categoryId String
    product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())

    @@unique([productId, categoryId])
    @@index([categoryId])
}

model ProductStockBooking {
    id            String   @id @default(cuid())
    productId     String
    userId        String
    quantityDelta Decimal  @db.Decimal(14, 3)
    supplier      String
    note          String?
    createdAt     DateTime @default(now())

    product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
    user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@index([productId])
    @@index([userId])
    @@index([createdAt])
}

model CostCenter {
    id        String   @id @default(cuid())
    code      String   @unique
    name      String
    isActive  Boolean  @default(true)
    orders    Order[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
    @@index([isActive])
}

model Order {
    id           String      @id @default(cuid())
    orderNumber  String      @unique
    userId       String
    costCenterId String
    storageRoomId String
    sourcePartListId String?
    workerNote   String?
    /** Private note the orderer writes for themselves; never shown to the warehouse. */
    personalNote String?
    status       OrderStatus @default(OPEN)
    approvalStatus OrderApprovalStatus @default(NOT_REQUIRED)
    approvalGroupId String?
    approvalDecidedById String?
    approvalDecidedAt DateTime?
    approvalNote String?
    approvalSnapshot Json?
    approvalReminderSentAt DateTime?
    user         User        @relation("OrderOwner", fields: [userId], references: [id], onDelete: Restrict)
    approvalGroup ApprovalGroup? @relation(fields: [approvalGroupId], references: [id], onDelete: SetNull)
    approvalDecidedBy User? @relation("OrderApprovalDecidedBy", fields: [approvalDecidedById], references: [id], onDelete: SetNull)
    costCenter   CostCenter  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
    storageRoom  StorageRoom @relation(fields: [storageRoomId], references: [id], onDelete: Restrict)
    sourcePartList PartList? @relation(fields: [sourcePartListId], references: [id], onDelete: SetNull)
    items        OrderItem[]
    sourceRequest OrderRequest?
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt

    @@index([userId])
    @@index([costCenterId])
    @@index([storageRoomId])
    @@index([sourcePartListId])
    @@index([status])
    @@index([approvalStatus])
    @@index([approvalGroupId])
    @@index([createdAt])
}

model ApprovalGroup {
    id          String   @id @default(cuid())
    name        String   @unique
    isActive    Boolean  @default(true)
    approverId  String
    deputyId    String?
    amountLimit Decimal? @db.Decimal(12, 2)
    approver    User     @relation("ApprovalGroupApprover", fields: [approverId], references: [id], onDelete: Restrict)
    deputy      User?    @relation("ApprovalGroupDeputy", fields: [deputyId], references: [id], onDelete: SetNull)
    members     User[]   @relation("ApprovalGroupMembers")
    orders      Order[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([approverId])
    @@index([deputyId])
}

model AppSetting {
    key       String   @id
    value     Json
    updatedAt DateTime @updatedAt
}

model PartList {
    id          String         @id @default(cuid())
    name        String
    description String?
    imageUrl    String?
    items       PartListItem[]
    documents   PartListDocument[]
    cartItems   CartItem[]
    orders      Order[]
    pinnedBy    UserPinnedPartList[]
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt

    @@unique([name])
    @@index([createdAt])
}

model PartListDocument {
    id           String   @id @default(cuid())
    partListId   String
    fileName     String
    originalName String
    url          String
    mimeType     String
    sizeBytes    Int
    partList     PartList @relation(fields: [partListId], references: [id], onDelete: Cascade)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([partListId, createdAt])
    @@unique([partListId, fileName])
}

model PartListItem {
    id         String   @id @default(cuid())
    partListId String
    productId  String
    quantity   Decimal  @db.Decimal(14, 3)
    partList   PartList @relation(fields: [partListId], references: [id], onDelete: Cascade)
    product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([partListId, productId])
    @@index([productId])
}

model OrderRequest {
    id                 String          @id @default(cuid())
    studentId          String
    teacherUserId      String?
    teacherExternalId  String
    teacherDisplayName String
    teacherEmail       String
    workerNote         String?
    status             RequestStatus   @default(PENDING)
    approvedOrderId    String?         @unique
    student            User            @relation("OrderRequestsAsStudent", fields: [studentId], references: [id], onDelete: Restrict)
    teacher            User?           @relation("OrderRequestsAsTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
    approvedOrder      Order?          @relation(fields: [approvedOrderId], references: [id], onDelete: SetNull)
    items              OrderRequestItem[]
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt

    @@index([studentId])
    @@index([teacherUserId])
    @@index([teacherExternalId])
    @@index([status])
    @@index([createdAt])
}

model OrderRequestItem {
    id             String       @id @default(cuid())
    orderRequestId String
    productId      String
    quantity       Decimal      @db.Decimal(14, 3)
    orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
    product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
    createdAt      DateTime     @default(now())

    @@index([orderRequestId])
    @@index([productId])
    @@unique([orderRequestId, productId])
}

model Loan {
    id String @id @default(cuid())

    borrowerId String
    borrower   User   @relation("LoansAsBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)

    teacherUserId String?
    teacher       User?   @relation("LoansAsTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
    teacherExternalId  String?
    teacherDisplayName String?
    teacherEmail        String?

    storageRoomId String
    storageRoom   StorageRoom @relation(fields: [storageRoomId], references: [id], onDelete: Restrict)

    status LoanStatus @default(PENDING)

    items LoanItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([borrowerId])
    @@index([storageRoomId])
    @@index([status])
    @@index([createdAt])
}

model LoanItem {
    id String @id @default(cuid())

    loanId String
    loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

    lendableItemId String
    lendableItem   LendableItem @relation(fields: [lendableItemId], references: [id], onDelete: Restrict)

    quantityRequested Decimal @db.Decimal(14, 3)
    quantityApproved  Decimal @default(0) @db.Decimal(14, 3)
    quantityHandedOver Decimal @default(0) @db.Decimal(14, 3)
    quantityReturned   Decimal @default(0) @db.Decimal(14, 3)

    borrowedAt DateTime?
    dueAt      DateTime?

    reminderLogs LoanReminderLog[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([loanId])
    @@index([lendableItemId])
    @@index([dueAt])
}

model LendableItem {
    id            String      @id @default(cuid())
    name          String
    description   String?
    quantityOnHand Int        @default(0)
    isVisible     Boolean     @default(true)
    storageRoomId String
    storageRoom   StorageRoom @relation(fields: [storageRoomId], references: [id], onDelete: Restrict)
    images        LendableItemImage[]
    loanItems     LoanItem[]
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    @@index([name])
    @@index([storageRoomId])
    @@index([isVisible])
}

model LendableItemImage {
    id             String       @id @default(cuid())
    lendableItemId String
    url            String
    altText        String?
    sortOrder      Int          @default(0)
    lendableItem   LendableItem @relation(fields: [lendableItemId], references: [id], onDelete: Cascade)
    createdAt      DateTime     @default(now())

    @@index([lendableItemId, sortOrder])
}

model LoanReminderLog {
    id String @id @default(cuid())

    loanItemId String
    loanItem   LoanItem @relation(fields: [loanItemId], references: [id], onDelete: Cascade)

    trigger LoanReminderTrigger
    sentForDate DateTime
    sentAt DateTime @default(now())

    @@unique([loanItemId, trigger, sentForDate])
    @@index([loanItemId, sentAt])
}

model OrderCounter {
    year       Int @id
    lastNumber Int
}

model OrderItem {
    id        String   @id @default(cuid())
    orderId   String
    productId String
    quantity  Decimal  @db.Decimal(14, 3)
    order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
    createdAt DateTime @default(now())

    @@index([orderId])
    @@index([productId])
    @@unique([orderId, productId])
}

model ProductImage {
    id        String   @id @default(cuid())
    productId String
    url       String
    altText   String?
    sortOrder Int      @default(0)
    product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@index([productId, sortOrder])
}

model ProductDocument {
    id           String   @id @default(cuid())
    productId    String
    fileName     String
    originalName String
    url          String
    mimeType     String
    sizeBytes    Int
    product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([productId, createdAt])
    @@unique([productId, fileName])
}

model Cart {
    id        String     @id @default(cuid())
    sessionId String     @unique
    items     CartItem[]
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
}

model CartItem {
    id               String    @id @default(cuid())
    cartId           String
    productId        String
    sourcePartListId String?
    quantity         Decimal   @default(1) @db.Decimal(14, 3)
    cart             Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
    product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
    sourcePartList   PartList? @relation(fields: [sourcePartListId], references: [id], onDelete: SetNull)
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    @@unique([cartId, productId, sourcePartListId])
    @@index([productId])
    @@index([sourcePartListId])
}

model SavedCart {
    id        String          @id @default(cuid())
    userId    String
    name      String
    user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    items     SavedCartItem[]
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    @@index([userId])
    @@unique([userId, name])
}

model SavedCartItem {
    id          String    @id @default(cuid())
    savedCartId String
    productId   String
    quantity    Decimal   @default(1) @db.Decimal(14, 3)
    savedCart   SavedCart @relation(fields: [savedCartId], references: [id], onDelete: Cascade)
    product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@unique([savedCartId, productId])
    @@index([productId])
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    azureAdObjectId String? @unique
    emailVerified DateTime?
    image         String?
    role          AppRole   @default(STUDENT)
    hasAllStorageRoomAccess Boolean @default(false)
    approvalGroupId String?
    approvalGroup ApprovalGroup? @relation("ApprovalGroupMembers", fields: [approvalGroupId], references: [id], onDelete: SetNull)
    approverOfGroups ApprovalGroup[] @relation("ApprovalGroupApprover")
    deputyOfGroups   ApprovalGroup[] @relation("ApprovalGroupDeputy")
    accounts      Account[]
    sessions      Session[]
    storageRoomAccesses UserStorageRoomAccess[]
    savedCarts    SavedCart[]
    orders        Order[] @relation("OrderOwner")
    approvalDecisions Order[] @relation("OrderApprovalDecidedBy")
    orderRequestsAsStudent OrderRequest[] @relation("OrderRequestsAsStudent")
    orderRequestsAsTeacher OrderRequest[] @relation("OrderRequestsAsTeacher")
    stockBookings ProductStockBooking[]
    pinnedPartLists UserPinnedPartList[]
    loansAsBorrower Loan[] @relation("LoansAsBorrower")
    loansAsTeacher  Loan[] @relation("LoansAsTeacher")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    @@index([approvalGroupId])
}

model UserPinnedPartList {
    id         String   @id @default(cuid())
    userId     String
    partListId String
    createdAt  DateTime @default(now())

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    partList PartList @relation(fields: [partListId], references: [id], onDelete: Cascade)

    @@unique([userId, partListId])
    @@index([userId, createdAt])
    @@index([partListId])
}

model UserStorageRoomAccess {
    id            String      @id @default(cuid())
    userId        String
    storageRoomId String
    user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
    storageRoom   StorageRoom @relation(fields: [storageRoomId], references: [id], onDelete: Cascade)
    createdAt     DateTime    @default(now())

    @@unique([userId, storageRoomId])
    @@index([storageRoomId])
}

model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@unique([identifier, token])
}

