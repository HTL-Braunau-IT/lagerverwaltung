# Lagershop – Konfiguration für selbst betriebene Installationen.
# Nach /srv/lagershop/.env kopieren, ausfüllen, `chmod 600 .env`.
# Erklärungen: README.md im Repository. Zufallswerte: `openssl rand -hex 32`
# Werte NICHT in Anführungszeichen setzen.

# --- Stack ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=lagershop
DATA_ROOT=/srv/lagershop
# Adresse, auf der die App (nur HTTP) lauscht. 127.0.0.1 = nur für einen
# Reverse Proxy auf demselben Server. 0.0.0.0 = im ganzen Netz erreichbar.
HTTP_BIND=127.0.0.1
HTTP_PORT=3000
# Update-Kanal (README, Abschnitt 5): stable = nur Releases (empfohlen).
APP_IMAGE=ghcr.io/htl-braunau-it/lagerverwaltung:stable

# --- Datenbank (läuft im selben Stack) --------------------------------------
POSTGRES_USER=lager
POSTGRES_DB=lagerverwaltung
# Nur Buchstaben und Ziffern: der Wert wird in die Datenbank-URL eingesetzt.
POSTGRES_PASSWORD=<zufallswert>

# --- App ----------------------------------------------------------------------
# Name im Kopfbereich, Seitentitel und in Abrechnungs-PDFs
SCHOOL_NAME=HTL Musterstadt
# Öffentliche Adresse, ohne / am Ende
AUTH_URL=https://lager.deine-schule.at
AUTH_SECRET=<zufallswert>

# --- Entra ID (README, Abschnitt 2) -------------------------------------------
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Objekt-IDs der Sicherheitsgruppen (Priorität: Admin > Lehrkraft > Schüler)
ROLE_ADMIN_GROUP_ID=
ROLE_TEACHER_GROUP_ID=
ROLE_STUDENT_GROUP_ID=

# --- E-Mail (optional, README, Abschnitt 2.4) ---------------------------------
# Freigegebenes Postfach als Absender; leer = keine Mails
MAIL_FROM_ADDRESS=
# Kopie aller Mails (auch in der Administration einstellbar)
MAIL_OPS_BCC_ADDRESS=

# --- Erinnerungen -------------------------------------------------------------
# Schützt die täglichen Erinnerungs-Aufrufe (Container `scheduler`).
CRON_SECRET=<zufallswert>
# Zeitzone für die Erinnerungen um 07:00
TZ=Europe/Vienna

# --- Update-Skript ------------------------------------------------------------
# docker-compose.yaml automatisch zur Version passend halten.
# Auf false setzen, wenn du die Compose-Datei selbst angepasst hast.
LAGERSHOP_SYNC_COMPOSE=true
