# Lagershop self-hosting configuration. Copy to `.env` and fill in.
# Details: docs/self-hosting.md

# --- Image ---------------------------------------------------------------
# main = every push to main, stable = only tagged releases (vX.Y.Z)
APP_TAG=main
APP_PORT=3000

# --- Database (used by docker-compose to build DATABASE_URL) ----------------
POSTGRES_USER=lager
POSTGRES_PASSWORD=
POSTGRES_DB=lagerverwaltung

# --- Branding --------------------------------------------------------------
# Shown in header, page title and billing PDFs
SCHOOL_NAME="HTL Musterstadt"

# --- Auth ------------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Public URL, without trailing slash
AUTH_URL=https://lager.example.at

# Entra ID app registration (redirect URI: <AUTH_URL>/api/auth/callback/azure-ad)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Entra group object IDs -> app roles (priority admin > teacher > student)
ROLE_ADMIN_GROUP_ID=
ROLE_TEACHER_GROUP_ID=
ROLE_STUDENT_GROUP_ID=

# --- Mail (optional; without MAIL_FROM_ADDRESS no mails are sent) -----------
MAIL_FROM_ADDRESS=
MAIL_OPS_BCC_ADDRESS=

# --- Cron endpoints (set both! unset = endpoints are unauthenticated) --------
# openssl rand -hex 32
CRON_SECRET=
LOAN_REMINDER_CRON_SECRET=
